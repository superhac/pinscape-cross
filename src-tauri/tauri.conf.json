{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinscape-Cross",
  "version": "0.1.0",
  "identifier": "io.github.superhac.pinscape-cross",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pinscape-Cross",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-pinscape.rules": "../packaging/udev/99-pinscape.rules"
        },
        "postInstallScript": "../packaging/linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/99-pinscape.rules": "../packaging/udev/99-pinscape.rules"
        },
        "postInstallScript": "../packaging/linux/postinst.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/superhac/pinscape-cross/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
